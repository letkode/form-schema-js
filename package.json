{
  "name": "@letkode/form-schema",
  "version": "1.0.0",
  "description": "YAML-driven form schema resolver — produces FormSchema JSON for any form renderer",
  "license": "MIT",
  "keywords": [
    "form",
    "form-schema",
    "form-builder",
    "form-renderer",
    "yaml",
    "schema",
    "dynamic-forms",
    "field-types",
    "react",
    "json-schema",
    "form-validation",
    "multi-tenant",
    "i18n",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/letkode/form-schema-js.git"
  },
  "homepage": "https://github.com/letkode/form-schema-js#readme",
  "bugs": {
    "url": "https://github.com/letkode/form-schema-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node test.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
